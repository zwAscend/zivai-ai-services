  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "health"
          ]
        }
      }
    },
    {
      "name": "Create Question (Computer Science)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "try {",
              "  const data = pm.response.json();",
              "  if (data.question_id) pm.environment.set('question_id', data.question_id);",
              "} catch (e) {}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"subject\": \"Computer Science\",\n  \"grade_level\": \"Form 4\",\n  \"topic\": \"Algorithms\",\n  \"question_no\": \"Q1\",\n  \"question_text\": \"State two differences between linear search and binary search.\",\n  \"max_marks\": 6,\n  \"rubric\": [\n    {\n      \"point_text\": \"Identifies linear search is sequential and binary search requires sorted data\",\n      \"marks\": 3,\n      \"keywords\": [\"sequential\", \"sorted\"]\n    },\n    {\n      \"point_text\": \"Compares time complexity (O(n) vs O(log n))\",\n      \"marks\": 3,\n      \"keywords\": [\"O(n)\", \"O(log n)\"]\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/questions",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "questions"
          ]
        }
      }
    },
    {
      "name": "Grade Submission",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "try {",
              "  const data = pm.response.json();",
              "  if (data.submission_id) pm.environment.set('submission_id', data.submission_id);",
              "} catch (e) {}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"question_id\": \"{{question_id}}\",\n  \"student_id\": \"S001\",\n  \"student_answer\": \"Linear search checks each item one by one and works on unsorted arrays. Binary search works on sorted arrays and repeatedly halves the search space, so it is faster: O(log n) versus O(n).\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/grade",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "grade"
          ]
        }
      }
    },
