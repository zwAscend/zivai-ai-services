        "body": {
          "mode": "raw",
          "raw": "{\n  \"grade\": {\n    \"score_awarded\": 5,\n    \"max_marks\": 6,\n    \"mark_points_awarded\": [\n      {\n        \"rubric_item_id\": \"RUB-MANUAL-1\",\n        \"awarded\": 3,\n        \"justification\": \"Student correctly explained sorted-data requirement and sequential scan difference.\"\n      },\n      {\n        \"rubric_item_id\": \"RUB-MANUAL-2\",\n        \"awarded\": 2,\n        \"justification\": \"Student compared complexities correctly but lacked detail.\"\n      }\n    ],\n    \"missing_points\": [\n      \"Could mention midpoint calculation step in binary search.\"\n    ],\n    \"feedback_short\": \"Good comparison with minor detail missing.\",\n    \"confidence\": 0.9\n  }\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/submissions/{{submission_id}}/override",
          "host": [
            "{{base_url}}"
          ],
          "path": [
